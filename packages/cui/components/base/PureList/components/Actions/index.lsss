.actions_wrap {
	width: calc(38px * 3 + 12px * 3);
	flex: none;
	padding-left: 12px;

	&.hasChildren {
		width: calc(38px * 5 + 12px * 5);
	}

	.btn_action {
		width: 38px;
		height: 38px;
		// 全局 custom_antd_styles 的 .xgen-btn{padding:7px 15px!important} 会覆盖
		// 普通声明，把方形图标按钮内容区挤到 8px、图标错位；这里用 !important 夺回
		padding: 0 !important;
		flex: none;

		svg {
			flex: none;
		}

		&.disabled {
			pointer-events: none;

			svg {
				opacity: 0.12;
			}
		}
	}
}
