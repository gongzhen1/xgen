{
      "private": true,
      "homepage": "https://yaoapps.com",
      "scripts": {
            "dev": "turbo run dev",
            "build": "turbo run build",
            "dev:cui": "turbo run dev --filter=cui",
            "build:cui": "turbo run build --filter=cui",
            "prettier": "prettier --parser=typescript --write \"**/*.ts?(x)\"",
            "submodule:init": "git submodule update --init --recursive",
            "submodule:update": "git submodule sync && git submodule update --recursive --remote --merge"
      },
      "gitHooks": {
            "pre-commit": "lint-staged --allow-empty"
      },
      "lint-staged": {
            "*.{js,jsx,less,md,json}": [
                  "prettier --write"
            ],
            "*.ts?(x)": [
                  "prettier --parser=typescript --write"
            ]
      },
      "devDependencies": {
            "lint-staged": "^13.1.0",
            "prettier": "^2.8.1",
            "turbo": "^1.7.2",
            "yorkie": "^2.0.0"
      },
      "dependencies": {
            "@types/react-beautiful-dnd": "^13.1.8",
            "@yaoapp/storex": "link:packages/storex",
            "mermaid": "^11.4.1",
            "mermaid-react": "^0.1.0",
            "react-beautiful-dnd": "^13.1.1"
      },
      "pnpm": {
            "overrides": {
                  "react": "^19.0.0",
                  "react-dom": "^19.0.0",
                  "@types/react": "^19.0.0",
                  "@types/react-dom": "^19.0.0"
            },
            "patchedDependencies": {
                  "http-deceiver": "patches/http-deceiver.patch",
                  "react-monaco-editor@0.51.0": "patches/react-monaco-editor@0.51.0.patch"
            }
      }
}